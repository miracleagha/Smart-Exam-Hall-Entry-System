# =================================================
# Smart Exam Hall Entry Verification System
# Backend Environment Variables
# =================================================

# Server
NODE_ENV=development
PORT=5000

# MongoDB
MONGODB_URI=mongodb://localhost:27017/smart-hall-entry

# JWT
JWT_SECRET=your-jwt-secret-here
JWT_REFRESH_SECRET=your-refresh-secret-here
JWT_EXPIRE=15m
JWT_REFRESH_EXPIRE=7d

# AES-256 Encryption (must be 32 bytes hex for key, 16 bytes hex for IV)
AES_SECRET_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
AES_IV=0123456789abcdef0123456789abcdef

# ==============================
# SMTP (Email)
# ==============================
# Example: Gmail with an App Password
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_SECURE=false
#   SMTP_USER=you@gmail.com
#   SMTP_PASS=your-16-char-app-password
#
# Example: SendGrid
#   SMTP_HOST=smtp.sendgrid.net
#   SMTP_PORT=587
#   SMTP_SECURE=false
#   SMTP_USER=apikey
#   SMTP_PASS=SG.your_sendgrid_api_key
#
# Example: Mailtrap (dev sandbox)
#   SMTP_HOST=sandbox.smtp.mailtrap.io
#   SMTP_PORT=2525
#   SMTP_SECURE=false
#   SMTP_USER=your-mailtrap-user
#   SMTP_PASS=your-mailtrap-pass
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=no-reply@smart-hall-entry.local
EMAIL_FROM_NAME=Smart Hall Entry

# Client URLs (used for email links only — CORS is open to all origins)
CLIENT_URL=http://localhost:5173
STUDENT_CLIENT_URL=http://localhost:5174

# Security
MAX_LOGIN_ATTEMPTS=5
LOCK_TIME_MINUTES=30

# QR Code
# Legacy exam-hall QR expiry (kept for backwards compatibility)
QR_EXPIRY_HOURS=24
# How long a student's identity QR remains valid (days).
STUDENT_QR_EXPIRY_DAYS=365
